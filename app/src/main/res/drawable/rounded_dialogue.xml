<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color for the dialog -->
    <solid android:color="@color/primary_bg_light" />

    <!-- Rounded corners with radius of 16dp -->
    <corners android:radius="16dp" />

    <!-- Optional padding inside the dialog -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />

    <!-- Optional border for the dialog -->
    <stroke
        android:width="1dp"
        android:color="@android:color/darker_gray" />
</shape>
